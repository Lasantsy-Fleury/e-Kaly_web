rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.: ]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "tokiniainanarivelosoa@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    function isApprovedPointer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pointer' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isOperationalUser() {
      return isAdmin() || isApprovedPointer();
    }

    // A distribution is only open when it has been explicitly opened
    // ("ongoing", legacy "active"). Time-slot expiry is enforced by the
    // clients (Web + Mobile) which close the distribution when heureFin is
    // reached; pointage writes are then rejected by the rules below.
    function isDistributionOpen(distributionId) {
      return distributionId is string &&
        get(/databases/$(database)/documents/distributions/$(distributionId)).data.statut in ['ongoing', 'active'];
    }

    // Test connection ping document
    match /test/{testId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Users and Pointers
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (isAdmin() || (request.resource.data.role == 'pointer' && request.resource.data.status == 'pending'));

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'requestedAt']) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status
          )
        );

      allow delete: if isAdmin();
    }

    // Sessions de voyage d'études
    match /sessions/{sessionId} {
      allow get, list: if isOperationalUser();
      allow create, update, delete: if isAdmin() && isValidId(sessionId);
    }

    // Students (Master 1 ENI)
    match /students/{studentId} {
      allow get, list: if isOperationalUser();
      allow create, update, delete: if isAdmin() && isValidId(studentId);
    }

    // Distributions
    match /distributions/{distributionId} {
      allow get, list: if isOperationalUser();
      allow create, delete: if isAdmin() && isValidId(distributionId);

      // Admin: full edit. Pointer: may only close an open distribution
      // (status + updatedAt) which powers automatic slot expiry on mobile
      // even when no administrator is connected.
      allow update: if isValidId(distributionId) &&
        (
          isAdmin() ||
          (
            isApprovedPointer() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'updatedAt']) &&
            request.resource.data.statut == 'completed' &&
            resource.data.statut in ['ongoing', 'active']
          )
        );
    }

    // Pointages (legacy mobile mirror, kept in sync with /attendance)
    match /pointages/{pointageId} {
      allow get, list: if isOperationalUser();

      allow create: if isValidId(pointageId) &&
        (
          isAdmin() ||
          (isApprovedPointer() && request.resource.data.pointerId == request.auth.uid)
        ) &&
        request.resource.data.keys().hasAll(['studentMatricule', 'distributionId', 'mealType']) &&
        isDistributionOpen(request.resource.data.distributionId);

      allow update: if isAdmin() ||
        (
          isApprovedPointer() &&
          resource.data.pointerId == request.auth.uid &&
          request.resource.data.pointerId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // Attendance Pointings (Web et Mobile)
    match /attendance/{attendanceId} {
      allow get, list: if isOperationalUser();

      // New pointages are only accepted while the distribution is open.
      // The client also checks this, but the rule is the authoritative gate.
      allow create: if isValidId(attendanceId) &&
        (
          isAdmin() ||
          (isApprovedPointer() && request.resource.data.pointeurId == request.auth.uid)
        ) &&
        request.resource.data.keys().hasAll(['matricule', 'distributionId', 'pointeurId', 'statut']) &&
        isDistributionOpen(request.resource.data.distributionId);

      // Idempotent re-sync of an existing pointage by its own author.
      // Administrative corrections (any field) remain restricted to admins.
      allow update: if isAdmin() ||
        (
          isApprovedPointer() &&
          resource.data.pointeurId == request.auth.uid &&
          request.resource.data.pointeurId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        request.resource.data.performedByUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
