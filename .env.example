# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION:
# Loaded automatically from firebase-applet-config.json
# Ensure your Firebase project has Cloud Firestore enabled and Google Authentication active.

# BACKEND API POSTGRESQL (Render):
VITE_API_URL="https://ekaly-backend.onrender.com"
